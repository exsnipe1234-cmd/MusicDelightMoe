# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# ── Supabase Service Role (server-side only, bypasses RLS) ──
# Used by API routes: /api/ai, /api/dashboard-summary, /api/create-account
# Find this in Supabase Dashboard → Project Settings → API → service_role secret
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ── OpenAI (server-side only) ──
# Used by /api/ai (chat assistant) and /api/import-image (OCR)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# ── OpenAI Model Overrides (optional) ──
# Defaults to gpt-4o-mini if not set
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_OCR_MODEL=gpt-4o-mini